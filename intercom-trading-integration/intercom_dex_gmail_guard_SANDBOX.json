      "parameters": {
        "jsCode": "const x=$input.first().json; if(x.mode!=='SANDBOX'||x.synthetic!==true||x.live_enabled!==false||!Array.isArray(x.pairs)||x.pairs.length!==2)throw new Error('Sandbox market contract required'); return [{json:{pairs:x.pairs,mode:'SANDBOX'}}];"
