      "parameters": {
        "jsCode": "const raw=$input.first().json.output; const c=typeof raw==='string'?JSON.parse(raw):raw; if(!c||typeof c!=='object'||Array.isArray(c))throw new Error('Invalid AI output'); if(c.side==='wait'||c.ready_to_trade!==true)return [{json:{valid:false,status:'WAIT_NO_ORDER'}}]; const valid=['TNK/USDC','RESET/USDC'].includes(c.pair)&&['buy','sell'].includes(c.side)&&typeof c.price==='number'&&Number.isFinite(c.price)&&c.price>0&&typeof c.amount==='number'&&Number.isFinite(c.amount)&&c.amount>0&&c.price*c.amount<=10&&typeof c.reason==='string'&&c.reason.length>0&&c.reason.length<=1000; if(!valid)throw new Error('Invalid candidate'); return [{json:{valid:true,request_id:'n8n:'+String($execution.id),candidate:c}}];"
