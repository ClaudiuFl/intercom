    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nlet pairs = raw?.pairs ?? raw?.data?.[0]?.pairs ?? raw?.data?.pairs;\nif (!pairs && Array.isArray(raw?.data)) pairs = raw.data.find(x => x?.pairs)?.pairs;\nif (!pairs) pairs = [];\nif (!Array.isArray(pairs)) pairs = Object.entries(pairs).map(([pair, value]) => ({pair, ...value}));\nreturn [{json:{pairs, source_ok: pairs.length > 0}}];"
      },
      "id": "e55444b3-1f16-46f5-8703-9b0ca3f01d0e",
      "name": "Normalize Market Feed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1440,
        -80
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analizează strict datele JSON oferite din Intercom DEX pentru TNK/USDC și RESET/USDC:\n{{ JSON.stringify($('Normalize Market Feed').first().json.pairs) }}\n\nO singură recomandare pentru cea mai bună pereche. Returnează doar JSON cu pair, side, price, amount, reason, ready_to_trade. Dacă piața e suspendată, lipsesc bestBuy/bestSell, lichiditatea, sau datele sunt incomplete: side=wait, price=null, amount=0, ready_to_trade=false. Nu inventa cotații. Nu transmite ordine. Pentru orice propunere pregătită, valoarea price*amount nu trebuie să depășească 10 USDC. Dacă nu poți calcula o propunere sigură, WAIT.",
        "hasOutputParser": true,
        "options": {}
      },
