          "values": {
            "approvalType": "double"
          }
        },
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        -368,
        -80
      ],
      "id": "3724f441-b55f-4569-b63e-9badd20bb6e2",
      "name": "Send message and wait for response"
    },
    {
      "parameters": {
        "jsCode": "const o = $input.first().json.output;\nconst x = typeof o === 'string' ? (() => {try {return JSON.parse(o)} catch {return {}}})() : (o || {});\nconst feed = $('Normalize Market Feed').first().json;\nconst pairs = feed.pairs || [];\nconst pairName = String(x.pair || '');\nconst m = pairs.find(p => [p.pair,p.symbol,p.name].includes(pairName));\nconst price = Number(x.price), amount = Number(x.amount);\nconst quote = m && [m.bestBuy,m.bestSell,m.bestBid,m.bestAsk,m.bid,m.ask].some(v => v !== undefined && v !== null && Number(v) > 0);\nconst marketActive = m && m.paused === false && m.active !== false && m.status !== 'paused';\nconst valid = feed.source_ok === true && marketActive && quote && x.ready_to_trade === true && ['buy','sell'].includes(x.side) && ['TNK/USDC','RESET/USDC'].includes(pairName) && Number.isFinite(price) && price > 0 && Number.isFinite(amount) && amount > 0 && price * amount <= 10;\nreturn [{json:{valid:!!valid, proposal: {pair:pairName,side:x.side,price,amount,ttlMin:60},reason:String(x.reason||''),test_only:true}}];"
      },
